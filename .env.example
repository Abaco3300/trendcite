# Optional LLM synthesis for `trendcite ... --llm`. Everything here is optional:
# TrendCite is fully functional without any of these variables.
# TrendCite does not load .env files itself; export these in your shell or use your own tooling.
# Never commit a real key.

# anthropic | openai
TRENDCITE_LLM_PROVIDER=

# Optional for Anthropic (default: claude-opus-5). Required for OpenAI.
TRENDCITE_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
