{
  "name": "trendcite-tcp008-fault-worker",
  "workers_dev": false,
  "vars": {
    "TC_P008_FAULT_SANDBOX": "isolated-dark"
  },
  "queues": {
    "producers": [
      {
        "binding": "PROBE_QUEUE",
        "queue": "trendcite-tcp008-fault-queue"
      }
    ],
    "consumers": [
      {
        "queue": "trendcite-tcp008-fault-queue",
        "dead_letter_queue": "trendcite-tcp008-fault-dlq",
        "max_batch_size": 1,
        "max_retries": 1
      }
    ]
  }
}
