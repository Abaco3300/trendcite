{
  "name": "trendcite-cloud-runtime",
  "main": "src/main.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_NONPROD_HYPERDRIVE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TREND_QUEUE",
        "queue": "REPLACE_WITH_NONPROD_QUEUE_NAME"
      }
    ],
    "consumers": [
      {
        "queue": "REPLACE_WITH_NONPROD_QUEUE_NAME",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "dead_letter_queue": "REPLACE_WITH_NONPROD_DLQ_NAME"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
