{
  "name": "trendcite-nonprod-runtime",
  "main": "src/main.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "TRENDCITE_RUNTIME_ROLE": "trendcite_nonprod_runtime",
    "SUPABASE_URL": "https://yntcafxmjgfjrdinwdmo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_HvHnOaQ77fNrD0vnZaN-aQ_lB7NNHrU",
    "TRENDCITE_CUSTOMER_MUTATIONS": "nonprod-enabled",
    "TRENDCITE_ENTITLEMENTS": "nonprod-enabled",
    "TRENDCITE_AUTOMATION": "nonprod-enabled",
    "TRENDCITE_AUTOMATION_STALE_SECONDS": "120",
    "TRENDCITE_AUTOMATION_RECOVERY_AFTER": "2026-10-07T21:30:00+00:00",
    "TRENDCITE_SCHEDULER_STALE_SECONDS": "600",
    "TRENDCITE_QUEUE_MAX_ATTEMPTS": "3",
    "VECTURL_BASE_URL": "https://vecturl.getistriade.com",
    "VECTURL_CONSUMER_ID": "trendcite-nonprod"
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "403038608f454b4b8172d9609f6a7383"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TREND_QUEUE",
        "queue": "trendcite-nonprod-queue"
      }
    ],
    "consumers": [
      {
        "queue": "trendcite-nonprod-queue",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "dead_letter_queue": "trendcite-nonprod-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
